# Optional. Leave unset in development: the app finds the API on the same computer as the
# Expo dev server (port 4000), for the browser preview, the emulator and a phone on the same Wi-Fi.
# Set it for a deployed API, e.g. EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_API_URL=

# Shown in the in-app Privacy Policy and Terms of Use (use the same values as web/.env).
EXPO_PUBLIC_LEGAL_NAME=
EXPO_PUBLIC_LEGAL_ADDRESS=
EXPO_PUBLIC_CONTACT_EMAIL=
EXPO_PUBLIC_ODPC_REGISTRATION=
