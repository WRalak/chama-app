// ───────────────────────────── identity ─────────────────────────────

model User {
  id                  String    @id @default(cuid())
  fullName            String
  phone               String    @unique
  email               String?   @unique
  passwordHash        String
  phoneVerifiedAt     DateTime?
  preferences         Json      @default("{}")
  /// App language (en, sw, …).
  locale              String    @default("en")
  nationalIdLast4     String?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  deletionRequestedAt DateTime?
  deletionReason      String?
  disabledAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions        Session[]
  pushDevices     PushDevice[]
  memberships     Membership[]
  notifications   Notification[]
  invitationsSent Invitation[]   @relation("InvitedBy")
  groupsCreated   Group[]        @relation("GroupCreatedBy")
  auditEvents     AuditEvent[]
  supportCases    SupportCase[]

  @@map("users")
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  refreshTokenHash  String    @unique
  /// Hash of the previous refresh token; presenting it again signals token theft.
  previousTokenHash String?   @unique
  deviceName        String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ───────────────────────────── groups ─────────────────────────────

model Group {
  id                      String      @id @default(cuid())
  name                    String
  type                    GroupType
  status                  GroupStatus @default(ACTIVE)
  description             String?
  county                  String?
  /// ISO 3166-1 alpha-2. The group's base currency is fixed once it has money records (database trigger).
  countryCode             String      @default("KE")
  currency                String      @default("KES")
  timezone                String      @default("Africa/Nairobi")
  locale                  String      @default("en-KE")
  registrationNumber      String?
  financialYearStartMonth Int         @default(1)
  inviteCode              String?     @unique
  settings                Json
  loanPolicy              Json
  /// Group overrides to the default role → permission matrix (within platform safeguards).
  rolePolicy              Json?
  createdById             String
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  createdBy        User                     @relation("GroupCreatedBy", fields: [createdById], references: [id])
  memberships      Membership[]
  invitations      Invitation[]
  schedules        ContributionSchedule[]
  obligations      ContributionObligation[]
  payments         Payment[]
  journalEntries   JournalEntry[]
  loans            Loan[]
  fines            Fine[]
  expenses         Expense[]
  cycles           PayoutCycle[]
  distributions    Distribution[]
  meetings         Meeting[]
  announcements    Announcement[]
  importBatches    ImportBatch[]
  disputes         Dispute[]
  holdings         InvestmentHolding[]
  subscription     Subscription?
  promotions       PromotionalGrant[]
  billingPayments  BillingPayment[]
  supportCases     SupportCase[]
  approvals        Approval[]
  unmatched        UnmatchedPayment[]
  supportGrants    SupportAccessGrant[]
  statements       PublishedStatement[]
  proposals        Proposal[]
  findings         AuditFinding[]
  destinations     PaymentDestination[]
  statementImports StatementImport[]

  @@map("groups")
}

model Membership {
  id           String           @id @default(cuid())
  groupId      String
  userId       String
  role         GroupRole        @default(MEMBER)
  /// Optional extra roles (loan committee, payout approver, joint signatory, read-only).
  specialRoles SpecialRole[]    @default([])
  status       MembershipStatus @default(ACTIVE)
  shares       Int              @default(0)
  joinedAt     DateTime         @default(now())
  exitedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  group         Group                    @relation(fields: [groupId], references: [id])
  user          User                     @relation(fields: [userId], references: [id])
  obligations   ContributionObligation[]
  payments      Payment[]
  loans         Loan[]
  fines         Fine[]
  rounds        PayoutRound[]
  attendance    Attendance[]
  allocations   DistributionAllocation[]
  approvals     Approval[]
  guarantees    LoanGuarantor[]
  actionItems   ActionItem[]
  disputes      Dispute[]
  scheduleLinks ScheduleMember[]
  journalLines  JournalEntry[]

  @@unique([groupId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(cuid())
  groupId     String
  phone       String
  fullName    String?
  role        GroupRole        @default(MEMBER)
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  group     Group @relation(fields: [groupId], references: [id])
  invitedBy User  @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([phone, status])
  @@index([groupId, status])
  @@map("invitations")
}

model SupportAccessGrant {
  id                    String             @id @default(cuid())
  groupId               String
  /// Legacy: staff used to be member accounts.
  requestedByUserId     String?
  /// The platform staff account that asked.
  requestedByAccountId  String?
  requestedByAccount    PlatformAccount?   @relation(fields: [requestedByAccountId], references: [id], onDelete: Restrict)
  purpose               String
  hours                 Int
  status                SupportGrantStatus @default(PENDING)
  decidedByMembershipId String?
  decidedAt             DateTime?
  expiresAt             DateTime?
  createdAt             DateTime           @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([requestedByUserId, groupId])
  @@index([requestedByAccountId, groupId])
  @@map("support_access_grants")
}

// ───────────────────────────── contributions ─────────────────────────────

model ContributionSchedule {
  id          String    @id @default(cuid())
  groupId     String
  name        String
  amountCents BigInt
  frequency   Frequency
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  active      Boolean   @default(true)
  allMembers  Boolean   @default(true)
  cycleId     String?   @unique
  createdById String
  createdAt   DateTime  @default(now())

  group       Group                    @relation(fields: [groupId], references: [id])
  obligations ContributionObligation[]
  members     ScheduleMember[]
  cycle       PayoutCycle?             @relation(fields: [cycleId], references: [id])

  @@index([groupId])
  @@map("contribution_schedules")
}

model ScheduleMember {
  scheduleId   String
  membershipId String
  /// Owes contributions due on or after this date (members joining mid-cycle).
  fromDate     DateTime? @db.Date
  /// Owes nothing due after this date (members leaving mid-cycle).
  untilDate    DateTime? @db.Date

  schedule   ContributionSchedule @relation(fields: [scheduleId], references: [id])
  membership Membership           @relation(fields: [membershipId], references: [id])

  @@id([scheduleId, membershipId])
  @@map("schedule_members")
}

model ContributionObligation {
  id           String           @id @default(cuid())
  groupId      String
  scheduleId   String
  membershipId String
  dueDate      DateTime         @db.Date
  periodLabel  String
  amountCents  BigInt
  paidCents    BigInt           @default(0)
  status       ObligationStatus @default(UPCOMING)
  roundId      String?
  waivedReason String?
  waivedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  group       Group                @relation(fields: [groupId], references: [id])
  schedule    ContributionSchedule @relation(fields: [scheduleId], references: [id])
  membership  Membership           @relation(fields: [membershipId], references: [id])
  round       PayoutRound?         @relation(fields: [roundId], references: [id])
  allocations PaymentAllocation[]
  fines       Fine[]

  @@unique([scheduleId, membershipId, dueDate])
  @@index([groupId, dueDate])
  @@index([membershipId, status])
  @@map("contribution_obligations")
}

model Payment {
  id             String            @id @default(cuid())
  groupId        String
  membershipId   String?
  amountCents    BigInt
  /// Always the group's base currency (set by a database trigger).
  currency       String            @default("KES")
  method         PaymentMethod
  source         PaymentSource     @default(MANUAL)
  purpose        PaymentPurpose
  status         TransactionStatus @default(PENDING)
  reference      String?
  paidAt         DateTime          @db.Date
  idempotencyKey String
  targetId       String?
  notes          String?
  recordedById   String?
  verifiedById   String?
  verifiedAt     DateTime?
  failureReason  String?
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String?
  /// Where the member says they sent the money.
  destinationId  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  group        Group               @relation(fields: [groupId], references: [id])
  membership   Membership?         @relation(fields: [membershipId], references: [id])
  destination  PaymentDestination? @relation(fields: [destinationId], references: [id])
  allocations  PaymentAllocation[]
  mpesaRequest MpesaRequest?
  disputes     Dispute[]
  evidence     PaymentEvidence[]
  events       PaymentEvent[]

  @@unique([groupId, idempotencyKey])
  @@index([groupId, status])
  @@index([groupId, reference])
  @@index([membershipId])
  @@map("payments")
}

model PaymentAllocation {
  id             String  @id @default(cuid())
  paymentId      String
  obligationId   String?
  installmentId  String?
  fineId         String?
  principalCents BigInt  @default(0)
  interestCents  BigInt  @default(0)
  amountCents    BigInt

  payment     Payment                 @relation(fields: [paymentId], references: [id])
  obligation  ContributionObligation? @relation(fields: [obligationId], references: [id])
  installment LoanInstallment?        @relation(fields: [installmentId], references: [id])
  fine        Fine?                   @relation(fields: [fineId], references: [id])

  @@index([paymentId])
  @@index([obligationId])
  @@index([installmentId])
  @@map("payment_allocations")
}

model MpesaRequest {
  id                String             @id @default(cuid())
  groupId           String
  paymentId         String             @unique
  merchantRequestId String?
  checkoutRequestId String?            @unique
  phone             String
  amountCents       BigInt
  status            MpesaRequestStatus @default(INITIATED)
  resultCode        Int?
  resultDesc        String?
  receiptNumber     String?            @unique
  rawCallback       Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("mpesa_requests")
}

model UnmatchedPayment {
  id               String               @id @default(cuid())
  groupId          String?
  source           String
  amountCents      BigInt
  reference        String               @unique
  payerPhone       String?
  payerName        String?
  accountReference String?
  receivedAt       DateTime
  status           ReconciliationStatus @default(UNMATCHED)
  matchedPaymentId String?
  raw              Json?
  createdAt        DateTime             @default(now())

  group Group? @relation(fields: [groupId], references: [id])

  @@index([groupId, status])
  @@map("unmatched_payments")
}

// ───────────────────────────── ledger ─────────────────────────────

/// A balanced journal entry. Lines always sum to zero (debit +, credit −).
model JournalEntry {
  id           String          @id @default(cuid())
  groupId      String
  /// Always the group's base currency (set by a database trigger).
  currency     String          @default("KES")
  entryDate    DateTime        @db.Date
  type         LedgerEntryType
  description  String
  reference    String?
  membershipId String?
  paymentId    String?
  loanId       String?
  expenseId    String?
  fineId       String?
  roundId      String?
  allocationId String?
  reversesId   String?         @unique
  reason       String?
  createdById  String?
  createdAt    DateTime        @default(now())

  group      Group         @relation(fields: [groupId], references: [id])
  membership Membership?   @relation(fields: [membershipId], references: [id])
  lines      JournalLine[]
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")

  @@index([groupId, entryDate])
  @@index([paymentId])
  @@map("journal_entries")
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  account     LedgerAccount
  amountCents BigInt

  entry JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@map("journal_lines")
}

model PublishedStatement {
  id            String   @id @default(cuid())
  groupId       String
  periodFrom    DateTime @db.Date
  periodTo      DateTime @db.Date
  snapshot      Json
  publishedById String
  publishedAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId, publishedAt])
  @@map("published_statements")
}

// ───────────────────────────── loans ─────────────────────────────

model Loan {
  id                     String         @id @default(cuid())
  groupId                String
  membershipId           String
  principalCents         BigInt
  rateBps                Int
  interestMethod         InterestMethod
  installmentsCount      Int
  frequency              Frequency
  totalInterestCents     BigInt
  purpose                String
  /// Officer who prepared the application for the member; may not approve it.
  preparedByMembershipId String?
  status                 LoanStatus     @default(PENDING_APPROVAL)
  requiredApprovals      Int
  allowSelfApproval      Boolean        @default(false)
  policySnapshot         Json
  appliedAt              DateTime       @default(now())
  decidedAt              DateTime?
  disbursedAt            DateTime?      @db.Date
  disbursementMethod     PaymentMethod?
  disbursementReference  String?
  disbursementKey        String?        @unique
  disbursedById          String?
  closedAt               DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  group        Group             @relation(fields: [groupId], references: [id])
  membership   Membership        @relation(fields: [membershipId], references: [id])
  installments LoanInstallment[]
  guarantors   LoanGuarantor[]

  @@index([groupId, status])
  @@index([membershipId])
  @@map("loans")
}

model LoanInstallment {
  id                 String            @id @default(cuid())
  loanId             String
  number             Int
  dueDate            DateTime          @db.Date
  principalCents     BigInt
  interestCents      BigInt
  principalPaidCents BigInt            @default(0)
  interestPaidCents  BigInt            @default(0)
  status             InstallmentStatus @default(UPCOMING)

  loan        Loan                @relation(fields: [loanId], references: [id])
  allocations PaymentAllocation[]

  @@unique([loanId, number])
  @@index([dueDate])
  @@map("loan_installments")
}

model LoanGuarantor {
  loanId       String
  membershipId String

  loan       Loan       @relation(fields: [loanId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([loanId, membershipId])
  @@map("loan_guarantors")
}

/// Generic approval record for maker-checker workflows.
model Approval {
  id                   String         @id @default(cuid())
  groupId              String
  entityType           ApprovalEntity
  entityId             String
  approverMembershipId String
  decision             ApprovalStatus
  comment              String?
  createdAt            DateTime       @default(now())

  group    Group      @relation(fields: [groupId], references: [id])
  approver Membership @relation(fields: [approverMembershipId], references: [id])

  @@unique([entityType, entityId, approverMembershipId])
  @@index([groupId, entityType, entityId])
  @@map("approvals")
}

// ───────────────────────────── fines & expenses ─────────────────────────────

model Fine {
  id           String     @id @default(cuid())
  groupId      String
  membershipId String
  amountCents  BigInt
  paidCents    BigInt     @default(0)
  reason       String
  issuedOn     DateTime   @db.Date
  status       FineStatus @default(OUTSTANDING)
  obligationId String?    @unique
  issuedById   String
  waivedById   String?
  waivedReason String?
  createdAt    DateTime   @default(now())

  group       Group                   @relation(fields: [groupId], references: [id])
  membership  Membership              @relation(fields: [membershipId], references: [id])
  obligation  ContributionObligation? @relation(fields: [obligationId], references: [id])
  allocations PaymentAllocation[]

  @@index([groupId, status])
  @@map("fines")
}

model Expense {
  id                String         @id @default(cuid())
  groupId           String
  category          String
  description       String
  amountCents       BigInt
  incurredOn        DateTime       @db.Date
  payee             String?
  status            ExpenseStatus  @default(PENDING_APPROVAL)
  requiredApprovals Int
  recordedById      String
  paidAt            DateTime?      @db.Date
  paymentMethod     PaymentMethod?
  paymentReference  String?
  paymentKey        String?        @unique
  createdAt         DateTime       @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId, status])
  @@map("expenses")
}

// ───────────────────────────── rotations ─────────────────────────────

model PayoutCycle {
  id                   String               @id @default(cuid())
  groupId              String
  name                 String
  status               CycleStatus          @default(ACTIVE)
  contributionCents    BigInt
  frequency            Frequency
  startDate            DateTime             @db.Date
  recipientContributes Boolean              @default(true)
  recipientsPerRound   Int                  @default(1)
  orderMethod          RotationOrderMethod  @default(AGREED)
  /// Server-generated seed for a random draw; published so anyone can re-run it.
  drawSeed             String?
  /// Participants fed to the draw (or carry-over), so the result is reproducible.
  drawParticipants     Json?
  previousCycleId      String?
  approvalMode         RotationApprovalMode @default(OFFICERS)
  /// Members' vote that approves the schedule, when approvalMode = MEMBER_VOTE.
  proposalId           String?              @unique
  /// The schedule exactly as approved. Later changes are amendments (cycle_changes).
  approvedPlan         Json?
  activatedAt          DateTime?
  createdById          String
  completedAt          DateTime?
  createdAt            DateTime             @default(now())

  group    Group                 @relation(fields: [groupId], references: [id])
  rounds   PayoutRound[]
  schedule ContributionSchedule?
  changes  CycleChange[]

  @@index([groupId])
  @@map("payout_cycles")
}

model PayoutRound {
  id                     String         @id @default(cuid())
  cycleId                String
  round                  Int
  /// Position within the round when a round pays several recipients.
  slot                   Int            @default(1)
  membershipId           String
  payoutDate             DateTime       @db.Date
  /// Projected round collection (all recipients); obligations are authoritative once generated.
  expectedCents          BigInt
  status                 PayoutStatus   @default(SCHEDULED)
  requiredApprovals      Int
  /// Incremented each time the payout is (re)prepared; approvals are tied to one preparation.
  preparationNo          Int            @default(0)
  preparedByMembershipId String?
  preparedAt             DateTime?
  preparedAmountCents    BigInt?
  readinessSnapshot      Json?
  shortfallReason        String?
  payoutMethod           PaymentMethod?
  payoutReference        String?
  payoutAmountCents      BigInt?
  completedAt            DateTime?
  cancelledReason        String?
  createdAt              DateTime       @default(now())

  cycle         PayoutCycle              @relation(fields: [cycleId], references: [id])
  membership    Membership               @relation(fields: [membershipId], references: [id])
  obligations   ContributionObligation[]
  disbursements PayoutDisbursement[]

  @@unique([cycleId, round, slot])
  @@map("payout_rounds")
}

/// Every attempt to send a payout. Rows are never overwritten: a failed
/// attempt stays FAILED and a retry is a new attempt.
model PayoutDisbursement {
  id                     String                  @id @default(cuid())
  groupId                String
  roundId                String
  attempt                Int
  idempotencyKey         String                  @unique
  amountCents            BigInt
  method                 PaymentMethod
  reference              String?
  destination            String?
  sentOn                 DateTime                @db.Date
  evidenceNote           String?
  recordedByMembershipId String
  status                 DisbursementStatus      @default(PROCESSING)
  confirmationKind       PayoutConfirmationKind?
  confirmedByUserId      String?
  confirmedAt            DateTime?
  confirmationNote       String?
  failureReason          String?
  failedByUserId         String?
  failedAt               DateTime?
  createdAt              DateTime                @default(now())

  round PayoutRound @relation(fields: [roundId], references: [id])

  @@unique([roundId, attempt])
  @@unique([groupId, reference])
  @@index([groupId, status])
  @@map("payout_disbursements")
}

model CycleChange {
  id                     String                @id @default(cuid())
  cycleId                String
  kind                   RotationAmendmentKind @default(REORDER)
  /// Members joining / leaving with this amendment.
  joined                 Json?
  left                   Json?
  beforeOrder            Json
  afterOrder             Json
  reason                 String
  proposedByMembershipId String
  status                 ApprovalStatus        @default(PENDING)
  createdAt              DateTime              @default(now())
  appliedAt              DateTime?

  cycle PayoutCycle @relation(fields: [cycleId], references: [id])

  @@map("cycle_changes")
}

// ───────────────────────────── distributions & investments ─────────────────────────────

model Distribution {
  id                String             @id @default(cuid())
  groupId           String
  title             String
  method            DistributionMethod
  periodFrom        DateTime           @db.Date
  periodTo          DateTime           @db.Date
  status            DistributionStatus @default(PENDING_APPROVAL)
  calculation       Json
  inputs            Json
  requiredApprovals Int
  createdById       String
  createdAt         DateTime           @default(now())

  group       Group                    @relation(fields: [groupId], references: [id])
  allocations DistributionAllocation[]

  @@index([groupId])
  @@map("distributions")
}

model DistributionAllocation {
  id               String         @id @default(cuid())
  distributionId   String
  membershipId     String
  grossCents       BigInt
  loanOffsetCents  BigInt         @default(0)
  netCents         BigInt
  paidAt           DateTime?      @db.Date
  paymentMethod    PaymentMethod?
  paymentReference String?
  paymentKey       String?        @unique

  distribution Distribution @relation(fields: [distributionId], references: [id])
  membership   Membership   @relation(fields: [membershipId], references: [id])

  @@unique([distributionId, membershipId])
  @@map("distribution_allocations")
}

model InvestmentHolding {
  id                String   @id @default(cuid())
  groupId           String
  name              String
  kind              String
  costCents         BigInt
  currentValueCents BigInt
  acquiredOn        DateTime @db.Date
  notes             String?
  createdAt         DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@map("investment_holdings")
}

// ───────────────────────────── meetings ─────────────────────────────

model Meeting {
  id             String        @id @default(cuid())
  groupId        String
  title          String
  scheduledAt    DateTime
  location       String?
  virtualLink    String?
  status         MeetingStatus @default(SCHEDULED)
  agenda         Json          @default("[]")
  requiresRsvp   Boolean       @default(true)
  reminderSentAt DateTime?
  createdById    String
  createdAt      DateTime      @default(now())

  group       Group        @relation(fields: [groupId], references: [id])
  attendance  Attendance[]
  minutes     Minutes?
  resolutions Resolution[]
  actions     ActionItem[]

  @@index([groupId, scheduledAt])
  @@map("meetings")
}

model Attendance {
  meetingId    String
  membershipId String
  status       AttendanceStatus
  updatedAt    DateTime         @updatedAt

  meeting    Meeting    @relation(fields: [meetingId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([meetingId, membershipId])
  @@map("attendance")
}

model Minutes {
  meetingId    String        @id
  body         String
  status       MinutesStatus @default(DRAFT)
  recordedById String
  approvedById String?
  approvedAt   DateTime?
  updatedAt    DateTime      @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("minutes")
}

model Resolution {
  id          String   @id @default(cuid())
  meetingId   String
  title       String
  details     String?
  isFinancial Boolean  @default(false)
  amountCents BigInt?
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id])

  @@map("resolutions")
}

model ActionItem {
  id                   String    @id @default(cuid())
  meetingId            String
  description          String
  assigneeMembershipId String?
  dueDate              DateTime? @db.Date
  done                 Boolean   @default(false)
  doneAt               DateTime?
  createdAt            DateTime  @default(now())

  meeting  Meeting     @relation(fields: [meetingId], references: [id])
  assignee Membership? @relation(fields: [assigneeMembershipId], references: [id])

  @@map("action_items")
}

model Announcement {
  id          String   @id @default(cuid())
  groupId     String
  title       String
  body        String
  createdById String
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@map("announcements")
}

// ───────────────────────────── notifications ─────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  groupId   String?
  type      NotificationType
  title     String
  body      String
  data      Json?
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus      @default(QUEUED)
  provider       String?
  error          String?
  attempts       Int                 @default(0)
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([status])
  @@map("notification_deliveries")
}

// ───────────────────────────── platform ─────────────────────────────

/// A ChamaHub plan. Prices are per region/currency/interval in plan_prices; entitlements are enforced by the API.
model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  /// Higher tier = more capable. Used to compare plans (upgrade vs downgrade).
  tier         Int      @default(0)
  /// { features: Feature[], limits: { maxMembers } }
  entitlements Json
  active       Boolean  @default(true)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prices          PlanPrice[]
  subscriptions   Subscription[]
  promotions      PromotionalGrant[]
  billingPayments BillingPayment[]

  @@map("plans")
}

model PlanPrice {
  id          String          @id @default(cuid())
  planId      String
  /// "*" = any country without a more specific price.
  countryCode String          @default("*")
  currency    String
  interval    BillingInterval
  amountMinor BigInt
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, countryCode, currency, interval])
  @@map("plan_prices")
}

model Subscription {
  id                 String             @id @default(cuid())
  groupId            String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  interval           BillingInterval?
  /// The price paid for the current period, kept so later price changes do not rewrite history.
  currency           String?
  amountMinor        BigInt?
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  /// A downgrade or interval change that takes effect at the end of the current period.
  scheduledPlanId    String?
  scheduledInterval  BillingInterval?
  /// Renewal reminders already sent for this period (days before end).
  remindersSent      Int[]              @default([])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  group    Group            @relation(fields: [groupId], references: [id])
  plan     Plan             @relation(fields: [planId], references: [id])
  payments BillingPayment[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Time-limited access to a plan granted by platform staff, with a reason. Revoking keeps the row.
model PromotionalGrant {
  id           String    @id @default(cuid())
  groupId      String
  planId       String
  reason       String
  startsAt     DateTime  @default(now())
  endsAt       DateTime
  grantedById  String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  group Group @relation(fields: [groupId], references: [id])
  plan  Plan  @relation(fields: [planId], references: [id])

  @@index([groupId, endsAt])
  @@map("promotional_grants")
}

/// A subscription charge. Amount and currency never change after creation (database trigger).
model BillingPayment {
  id             String               @id @default(cuid())
  /// Unique, human-readable reference given to the provider and shown on receipts.
  reference      String               @unique
  groupId        String
  subscriptionId String?
  planId         String
  interval       BillingInterval
  purpose        BillingPurpose
  provider       String
  providerRef    String?
  /// false = provider test/sandbox mode. Test payments never count as revenue.
  livemode       Boolean
  currency       String
  /// List price for the period.
  priceMinor     BigInt
  /// Unused time from the previous period credited on an upgrade.
  creditMinor    BigInt               @default(0)
  /// What the payer is asked to pay: price − credit.
  amountMinor    BigInt
  feeMinor       BigInt?
  refundedMinor  BigInt               @default(0)
  status         BillingPaymentStatus @default(PENDING)
  failureReason  String?
  idempotencyKey String               @unique
  initiatedById  String?
  /// Masked, e.g. 2547****5678. Never a PIN or OTP.
  payerHint      String?
  periodStart    DateTime?
  periodEnd      DateTime?
  receiptNumber  String?              @unique
  paidAt         DateTime?
  lastCheckedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  group        Group           @relation(fields: [groupId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  refunds      BillingRefund[]
  events       BillingEvent[]
  plan         Plan            @relation(fields: [planId], references: [id])

  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@index([groupId, createdAt])
  @@map("billing_payments")
}

/// Every provider notification, stored once (by provider event id) and never edited.
model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  paymentId       String?
  livemode        Boolean
  signatureValid  Boolean
  /// Provider payload with personal data removed.
  payload         Json
  result          String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  payment BillingPayment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@map("billing_events")
}

model BillingRefund {
  id          String              @id @default(cuid())
  paymentId   String
  amountMinor BigInt
  currency    String
  reason      String
  provider    String
  providerRef String?
  status      BillingRefundStatus @default(PENDING)
  createdById String
  createdAt   DateTime            @default(now())

  payment BillingPayment @relation(fields: [paymentId], references: [id])

  @@map("billing_refunds")
}

/// Subscription history: every plan or status change, with who and why. Append-only.
model SubscriptionEvent {
  id          String   @id @default(cuid())
  groupId     String
  type        String
  fromPlan    String?
  toPlan      String?
  fromStatus  String?
  toStatus    String?
  paymentId   String?
  actorUserId String?
  reason      String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([type, createdAt])
  @@map("subscription_events")
}

model BillingCase {
  id           String              @id @default(cuid())
  groupId      String?
  paymentId    String?
  subject      String
  details      String
  status       BillingCaseStatus   @default(OPEN)
  priority     BillingCasePriority @default(NORMAL)
  createdById  String
  assignedToId String?
  resolution   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("billing_cases")
}

/// Countries ChamaHub knows about. Only `available` ones accept new groups.
model Region {
  countryCode      String   @id
  name             String
  defaultCurrency  String
  defaultTimezone  String
  defaultLocale    String
  available        Boolean  @default(false)
  billingAvailable Boolean  @default(false)
  notes            String?
  updatedAt        DateTime @updatedAt

  @@map("regions")
}

/// Which provider can take subscription payments in which country and currency, and how.
model BillingProviderAvailability {
  id          String   @id @default(cuid())
  provider    String
  countryCode String
  currency    String
  methods     String[]
  recurring   Boolean  @default(false)
  refunds     Boolean  @default(false)
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([provider, countryCode, currency])
  @@map("billing_provider_availability")
}

/// 1 base = rate quote on asOf, entered by finance staff with its source. Used only for consolidated reports.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(24, 12)
  asOf          DateTime @db.Date
  source        String
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, asOf])
  @@map("exchange_rates")
}

model OperatingCost {
  id           String                @id @default(cuid())
  category     OperatingCostCategory
  description  String
  currency     String
  amountMinor  BigInt
  incurredOn   DateTime              @db.Date
  source       String?
  recordedById String
  createdAt    DateTime              @default(now())

  @@index([incurredOn])
  @@map("operating_costs")
}

model AuditEvent {
  id             String   @id @default(cuid())
  groupId        String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  reference      String?
  approvalStatus String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([groupId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_events")
}

model ImportBatch {
  id           String       @id @default(cuid())
  groupId      String
  kind         ImportKind
  fileName     String
  status       ImportStatus
  rows         Json
  summary      Json         @default("{}")
  rowCount     Int
  errorCount   Int
  warningCount Int
  uploadedById String
  reviewedById String?
  committedAt  DateTime?
  createdAt    DateTime     @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("import_batches")
}

model Dispute {
  id           String        @id @default(cuid())
  groupId      String
  membershipId String
  paymentId    String?
  /// A payout the dispute is about (e.g. a recipient reporting money not received).
  roundId      String?
  subject      String
  details      String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  group      Group      @relation(fields: [groupId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([groupId, status])
  @@map("disputes")
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  status     JobStatus
  startedAt  DateTime
  finishedAt DateTime
  details    Json?
  error      String?

  @@index([name, startedAt])
  @@map("job_runs")
}

// ───────────────────────────── decisions & audit findings ─────────────────────────────

model Proposal {
  id            String         @id @default(cuid())
  groupId       String
  title         String
  description   String
  status        ProposalStatus @default(OPEN)
  quorumPercent Int
  passPercent   Int
  /// Members eligible when the vote opened; fixed so the result is reproducible.
  eligibleCount Int
  createdById   String
  closesAt      DateTime
  closedAt      DateTime?
  result        Json?
  /// What the vote decides, e.g. subjectType "PayoutCycle" activates a rotation when passed.
  subjectType   String?
  subjectId     String?
  createdAt     DateTime       @default(now())

  group Group  @relation(fields: [groupId], references: [id])
  votes Vote[]

  @@index([groupId, status])
  @@map("proposals")
}

/// One ballot per eligible member; ballots cannot be changed once cast.
model Vote {
  proposalId   String
  membershipId String
  choice       VoteChoice
  createdAt    DateTime   @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@id([proposalId, membershipId])
  @@map("votes")
}

model AuditFinding {
  id                      String          @id @default(cuid())
  groupId                 String
  raisedByMembershipId    String
  title                   String
  details                 String
  severity                FindingSeverity
  status                  FindingStatus   @default(OPEN)
  entityType              String?
  entityId                String?
  reference               String?
  response                String?
  respondedByMembershipId String?
  resolvedAt              DateTime?
  createdAt               DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId, status])
  @@map("audit_findings")
}

/// Platform-wide configuration (one row per key), changed only by super admins.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Expo push tokens of the user's signed-in devices. A token moves to whoever signs in on that device.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// ───────────────────────────── collections ─────────────────────────────

/// Where members send money. Details never change after creation: a change
/// is a new destination that replaces the old one once another officer approves.
model PaymentDestination {
  id                      String                  @id @default(cuid())
  groupId                 String
  type                    DestinationType
  displayName             String
  provider                String?
  accountNumber           String?
  accountReference        String?
  accountName             String?
  branch                  String?
  instructions            String?
  /// CONTRIBUTION / LOAN_REPAYMENT / FINE. Empty means any purpose.
  intendedUse             String[]                @default([])
  responsibleMembershipId String?
  verification            DestinationVerification @default(MANUAL_REVIEW)
  status                  DestinationStatus       @default(PENDING_APPROVAL)
  effectiveFrom           DateTime                @db.Date
  effectiveTo             DateTime?               @db.Date
  replacesId              String?
  proposedByMembershipId  String
  proposalReason          String?
  requiredApprovals       Int                     @default(1)
  decidedAt               DateTime?
  rejectionReason         String?
  retiredReason           String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  group      Group                @relation(fields: [groupId], references: [id])
  replaces   PaymentDestination?  @relation("DestinationReplacement", fields: [replacesId], references: [id])
  replacedBy PaymentDestination[] @relation("DestinationReplacement")
  payments   Payment[]
  imports    StatementImport[]

  @@index([groupId, status])
  @@map("payment_destinations")
}

/// A receipt photo, screenshot or bank slip attached to a payment. Stored in
/// the database (small files only) so evidence travels with the records.
model PaymentEvidence {
  id           String   @id @default(cuid())
  groupId      String
  paymentId    String
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  data         Bytes
  note         String?
  uploadedById String
  createdAt    DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, sha256])
  @@index([groupId])
  @@map("payment_evidence")
}

/// Append-only history of a payment. Status changes are written by a database
/// trigger, so no code path can change a payment's status without a record.
model PaymentEvent {
  id          String             @id @default(cuid())
  groupId     String
  paymentId   String
  kind        String
  fromStatus  TransactionStatus?
  toStatus    TransactionStatus?
  actorUserId String?
  note        String?
  createdAt   DateTime           @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

/// An uploaded M-Pesa / Paybill / bank statement, kept for review.
model StatementImport {
  id             String                @id @default(cuid())
  groupId        String
  destinationId  String?
  fileName       String
  fileSha256     String
  mapping        Json
  status         StatementImportStatus @default(REVIEWING)
  lineCount      Int
  duplicateCount Int                   @default(0)
  periodFrom     DateTime?             @db.Date
  periodTo       DateTime?             @db.Date
  uploadedById   String
  createdAt      DateTime              @default(now())

  group       Group               @relation(fields: [groupId], references: [id])
  destination PaymentDestination? @relation(fields: [destinationId], references: [id])
  lines       StatementLine[]

  @@index([groupId, createdAt])
  @@map("statement_imports")
}

model StatementLine {
  id                    String             @id @default(cuid())
  importId              String
  groupId               String
  rowNo                 Int
  transactionAt         DateTime
  /// Positive = money in; negative = money out.
  amountCents           BigInt
  reference             String?
  payerName             String?
  payerPhone            String?
  accountReference      String?
  description           String?
  /// Stable identity of the transaction, for duplicate detection across imports.
  fingerprint           String
  match                 StatementMatch
  /// Candidate memberships with scores and reasons, as the engine saw them.
  candidates            Json               @default("[]")
  suggestedMembershipId String?
  reportPaymentId       String?
  state                 StatementLineState @default(OPEN)
  resolvedMembershipId  String?
  resolvedPaymentId     String?
  resolvedById          String?
  resolvedAt            DateTime?
  resolutionNote        String?

  statementImport StatementImport @relation(fields: [importId], references: [id])

  @@index([groupId, state])
  @@index([groupId, fingerprint])
  @@index([importId, rowNo])
  @@map("statement_lines")
}

// ───────────────────────────── AI assistant ─────────────────────────────
// Kept apart from the financial records: nothing here is a source of truth for
// money, and conversations expire under AI_RETENTION_DAYS.

/// One assistant conversation, owned by one member of one group.
model AiConversation {
  id           String      @id @default(cuid())
  groupId      String
  userId       String
  membershipId String
  title        String
  locale       String      @default("en")
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AiMessage[]

  @@index([groupId, userId, updatedAt])
  @@index([expiresAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  /// user | assistant (tool results are stored as user turns, as the API expects).
  role           String
  /// Exactly what was sent to / received from the provider, so history replays unchanged.
  content        Json
  /// What the app shows: the text and the record cards the answer was built from. Null for internal turns.
  display        Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// One request to the AI provider (or one refused by a limit), for cost tracking and monitoring.
model AiUsage {
  id               String   @id @default(cuid())
  groupId          String
  userId           String
  conversationId   String?
  feature          String
  provider         String
  model            String
  /// OK | ERROR | TIMEOUT | RATE_LIMITED | REFUSED | LIMIT_REACHED | UNAVAILABLE
  status           String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicroUsd     Int      @default(0)
  latencyMs        Int      @default(0)
  toolCalls        Int      @default(0)
  errorCode        String?
  createdAt        DateTime @default(now())

  @@index([groupId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

/// Every tool the assistant asked to run, whether it ran, and why not.
model AiToolCall {
  id             String   @id @default(cuid())
  groupId        String
  userId         String
  conversationId String?
  /// "direct" when the member ran the tool from a suggestion without the model.
  via            String
  tool           String
  input          Json
  /// OK | DENIED | INVALID | UNKNOWN_TOOL | ERROR
  outcome        String
  error          String?
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("ai_tool_calls")
}

// ───────────────────────────── officer handovers ─────────────────────────────

/// What an incoming officer takes over: figures from the ledger and open work at
/// the moment of the change. The snapshot never changes; the incoming officer
/// acknowledges it once.
model OfficerHandover {
  id                   String    @id @default(cuid())
  groupId              String
  role                 GroupRole
  outgoingMembershipId String?
  incomingMembershipId String?
  /// "role_change" when created by a role change, "manual" when an officer prepared it.
  trigger              String
  snapshot             Json
  notes                String?
  createdById          String
  acknowledgedById     String?
  acknowledgedAt       DateTime?
  acknowledgementNote  String?
  createdAt            DateTime  @default(now())

  @@index([groupId, createdAt])
  @@map("officer_handovers")
}

// ───────────────────────────── platform administration portal ─────────────────────────────
// Staff identities are separate from Chama members: a treasurer in a Chama is never a platform
// administrator because of that membership. Staff sign in with e-mail and password (scrypt), have
// database-backed roles and permissions, and every sensitive action is in platform_audit_log.

enum PlatformAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model PlatformAccount {
  id                String                @id @default(cuid())
  /// Stored lower-case.
  email             String                @unique
  fullName          String
  /// scrypt$N$r$p$salt$hash; null until the invitation is accepted. Never returned by the API.
  passwordHash      String?
  status            PlatformAccountStatus @default(INVITED)
  team              String?
  /// TOTP secret, encrypted (AES-256-GCM) with a key derived from the platform token secret.
  mfaSecret         String?
  mfaEnabled        Boolean               @default(false)
  /// Last accepted TOTP time step: a code is never accepted twice.
  mfaLastStep       Int?
  failedLoginCount  Int                   @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  /// Temporary helpers stop working after this time.
  expiresAt         DateTime?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  roles          PlatformAccountRole[]
  permissions    PlatformAccountPermission[]
  sessions       PlatformSession[]
  invitations    PlatformInvitation[]
  passwordResets PlatformPasswordReset[]
  recoveryCodes  PlatformRecoveryCode[]
  assignedCases  SupportCase[]
  supportGrants  SupportAccessGrant[]

  @@index([status])
  @@map("platform_accounts")
}

model PlatformStaffRole {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  /// Built-in roles cannot be deleted; the owner role's permissions cannot be reduced.
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlatformRolePermission[]
  accounts    PlatformAccountRole[]

  @@map("platform_roles")
}

model PlatformRolePermission {
  roleId     String
  permission String

  role PlatformStaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("platform_role_permissions")
}

model PlatformAccountRole {
  accountId   String
  roleId      String
  grantedById String?
  createdAt   DateTime @default(now())

  account PlatformAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    PlatformStaffRole @relation(fields: [roleId], references: [id])

  @@id([accountId, roleId])
  @@map("platform_account_roles")
}

/// Individual permissions granted on top of an account's roles.
model PlatformAccountPermission {
  accountId   String
  permission  String
  grantedById String?
  createdAt   DateTime @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, permission])
  @@map("platform_account_permissions")
}

/// Single-use invitation: only the SHA-256 of the token is stored.
model PlatformInvitation {
  id          String    @id @default(cuid())
  accountId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("platform_invitations")
}

model PlatformPasswordReset {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("platform_password_resets")
}

/// Single-use two-step recovery codes; only their SHA-256 is stored.
model PlatformRecoveryCode {
  id        String    @id @default(cuid())
  accountId String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, codeHash])
  @@index([accountId, usedAt])
  @@map("platform_recovery_codes")
}

model PlatformSession {
  id               String    @id @default(cuid())
  accountId        String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  /// Absolute end of the session.
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  /// Last time the person proved who they are in this session (sign-in or re-authentication).
  reauthAt         DateTime  @default(now())

  account PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@map("platform_sessions")
}

enum PlatformAuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Append-only (database trigger). No passwords, tokens or payment credentials are ever written.
model PlatformAuditLog {
  id             String               @id @default(cuid())
  actorAccountId String?
  /// For actions without an account (failed login): the e-mail tried, or "system".
  actorLabel     String?
  action         String
  targetType     String?
  targetId       String?
  outcome        PlatformAuditOutcome @default(SUCCESS)
  reason         String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  before         Json?
  after          Json?
  createdAt      DateTime             @default(now())

  @@index([createdAt])
  @@index([actorAccountId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("platform_audit_log")
}

enum SupportCategory {
  ACCOUNT_ACCESS
  CONTRIBUTIONS_PAYMENTS
  PAYOUT_ROTATION
  LOANS_REPAYMENTS
  SUBSCRIPTION_BILLING
  TECHNICAL
  FEATURE_REQUEST
  SECURITY
  OTHER
}

enum SupportStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_USER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportCase {
  id               String          @id @default(cuid())
  /// Human-friendly: CH-001234.
  number           String          @unique
  requesterUserId  String
  groupId          String?
  subject          String
  category         SupportCategory
  description      String
  priority         SupportPriority @default(NORMAL)
  status           SupportStatus   @default(OPEN)
  assignedToId     String?
  resolution       String?
  escalationReason String?
  escalatedAt      DateTime?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  requester   User                  @relation(fields: [requesterUserId], references: [id])
  group       Group?                @relation(fields: [groupId], references: [id])
  assignedTo  PlatformAccount?      @relation(fields: [assignedToId], references: [id])
  messages    SupportMessage[]
  notes       SupportInternalNote[]
  assignments SupportAssignment[]

  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([requesterUserId, createdAt])
  @@map("support_cases")
}

/// The conversation the user sees. Append-only.
model SupportMessage {
  id              String   @id @default(cuid())
  caseId          String
  authorUserId    String?
  authorAccountId String?
  body            String
  createdAt       DateTime @default(now())

  case SupportCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("support_messages")
}

/// Staff-only notes, in their own table so no user-facing query can include them. Append-only.
model SupportInternalNote {
  id              String   @id @default(cuid())
  caseId          String
  authorAccountId String
  body            String
  createdAt       DateTime @default(now())

  case SupportCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("support_internal_notes")
}

/// Assignment history. Append-only.
model SupportAssignment {
  id           String   @id @default(cuid())
  caseId       String
  assignedToId String?
  assignedById String?
  createdAt    DateTime @default(now())

  case SupportCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("support_assignments")
}

/// Shared request counters for rate limiting across API instances (RATE_LIMIT_STORE=database).
model RateLimitBucket {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
