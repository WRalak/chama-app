/// What the matching engine concluded about a statement line.
enum StatementMatch {
  /// The line matches a payment a member reported (same reference and amount).
  REPORT_MATCH
  /// Exactly one member fits strongly (phone, or account reference).
  STRONG
  /// One weak candidate (name only, or amount differs). Needs a person.
  SUGGESTED
  /// Several members fit. Never assigned without a person choosing.
  AMBIGUOUS
  UNMATCHED
  /// The reference was already recorded or imported.
  DUPLICATE
  /// Money leaving the account: not a contribution.
  OUTGOING
}

