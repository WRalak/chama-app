// ChamaHub authoritative data model.
//
// Money: every monetary column is BigInt KES cents. Never Float/Decimal-as-float.
// Group isolation: every group-owned row carries groupId and is only read
// through group-scoped queries.
// Immutability: journal entries/lines and audit events are append-only
// (enforced by database triggers in the initial migration). Corrections are
// reversal journal entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

