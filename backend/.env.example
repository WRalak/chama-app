# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chamahub:chamahub@localhost:5432/chamahub
# Supabase: use the *Session pooler* string from the project's Connect dialog (port 5432,
# works over IPv4 and supports migrations). Not the transaction pooler (6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
OTP_SECRET=change-me-otp-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Exact browser origins allowed to call the API. In production: https:// origins only, no * (the API refuses to start otherwise).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# In development OTP codes are written to the API log instead of being sent.
DEV_LOG_OTP=true
# Optional alert for every server error (5xx): a webhook URL (Slack, Teams, an alerting service).
# The report holds status, error type, route and request id only, never request or financial data.
ERROR_WEBHOOK_URL=

# ---- Subscription billing (ChamaHub's own fees; never a group's money) — see docs/BILLING.md ----
# Public URL providers call back: <BILLING_CALLBACK_BASE_URL>/<PROVIDER>
BILLING_CALLBACK_BASE_URL=
# Secret put in M-Pesa callback URLs (Daraja does not sign callbacks). At least 24 random characters.
BILLING_WEBHOOK_TOKEN=
# ChamaHub's OWN Daraja app and shortcode (not a group's). sandbox | production
BILLING_MPESA_ENV=sandbox
BILLING_MPESA_CONSUMER_KEY=
BILLING_MPESA_CONSUMER_SECRET=
BILLING_MPESA_SHORTCODE=
BILLING_MPESA_PASSKEY=
# CustomerPayBillOnline | CustomerBuyGoodsOnline; for Buy Goods set the till in BILLING_MPESA_PARTY_B
BILLING_MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
BILLING_MPESA_PARTY_B=
# Paystack secret key (sk_test_… or sk_live_…); register <BILLING_CALLBACK_BASE_URL>/PAYSTACK as the webhook URL
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
# Bank-transfer instructions for invoice payments, '|' separates lines
BILLING_MANUAL_INSTRUCTIONS=
# Shown on receipts. Add a tax registration (e.g. KRA PIN) only once registered.
BILLING_SELLER_NAME=ChamaHub
BILLING_SELLER_ADDRESS=
BILLING_SELLER_EMAIL=
BILLING_SELLER_TAX_ID=
# Development/test sandbox provider secret (ignored in production)
BILLING_SANDBOX_SECRET=

# ---- SMS (Africa's Talking) — leave blank to disable ----
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Email (SMTP relay over HTTP is not bundled; leave blank to disable) ----
# E-mail relay (POST {to, subject, text}). Staff invitations and password resets are sent through it;
# without it the portal shows the inviter a one-time link instead.
EMAIL_WEBHOOK_URL=

# ---- WhatsApp Business Cloud API — requires an approved WABA ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- M-Pesa Daraja — leave blank to disable ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Safaricom will call, e.g. https://api.example.com/v1/integrations/mpesa/stk-callback
MPESA_CALLBACK_URL=
# Shared secret appended as ?token= to callback URLs so forged callbacks are rejected.
MPESA_CALLBACK_TOKEN=

# AI assistant (server-side only; never put the key in the mobile or web apps).
# Without a key the assistant chat is off; its record cards keep working.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ROUNDS=6
AI_DAILY_REQUESTS_PER_USER=40
AI_MONTHLY_BUDGET_USD_PER_GROUP=10
AI_RETENTION_DAYS=30

# ---- Platform staff portal (/platform) ----
# Signs staff tokens. Unset: derived from JWT_ACCESS_SECRET with a separate label (member tokens never work on the portal).
# Set your own 32+ character value in production so the two can be rotated independently.
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_TTL_SECONDS=600
# Staff sessions end after this much inactivity, and always after the maximum.
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_MAX_HOURS=12
PLATFORM_INVITE_TTL_HOURS=72
PLATFORM_RESET_TTL_MINUTES=30
# The web app's public origin, used in invitation and reset links.
PLATFORM_PORTAL_URL=http://localhost:3000
# Staff must set up two-step sign-in (authenticator app). Leave on; 'false' only for local experiments.
PLATFORM_REQUIRE_MFA=true
# Sensitive staff actions need the password (and authenticator code) again after this many minutes.
PLATFORM_REAUTH_MINUTES=10
# One-time owner bootstrap (npm run platform:bootstrap -- --confirm). Remove after use.
# PLATFORM_BOOTSTRAP_EMAIL=
# PLATFORM_BOOTSTRAP_NAME=
