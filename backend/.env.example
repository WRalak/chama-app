# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chamahub:chamahub@localhost:5432/chamahub
# Supabase: use the *Session pooler* string from the project's Connect dialog (port 5432,
# works over IPv4 and supports migrations). Not the transaction pooler (6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
OTP_SECRET=change-me-otp-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# In development OTP codes are written to the API log instead of being sent.
DEV_LOG_OTP=true

# ---- SMS (Africa's Talking) — leave blank to disable ----
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Email (SMTP relay over HTTP is not bundled; leave blank to disable) ----
EMAIL_WEBHOOK_URL=

# ---- WhatsApp Business Cloud API — requires an approved WABA ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- M-Pesa Daraja — leave blank to disable ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Safaricom will call, e.g. https://api.example.com/v1/integrations/mpesa/stk-callback
MPESA_CALLBACK_URL=
# Shared secret appended as ?token= to callback URLs so forged callbacks are rejected.
MPESA_CALLBACK_TOKEN=
