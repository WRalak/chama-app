{
  "name": "@chamahub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src/",
    "test:e2e": "jest --runInBand --testPathPattern=test/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "platform:bootstrap": "ts-node --transpile-only -P tsconfig.json src/cli/platform-bootstrap.ts",
    "seed": "ts-node --transpile-only -P tsconfig.json prisma/seed.ts",
    "postinstall": "prisma generate || node -e \"console.warn('\\nPrisma client not generated (network?). It is retried when you run npm run dev in backend.\\n')\"",
    "predev": "prisma generate && npm run build --prefix ../packages/shared"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -P tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@chamahub/shared": "*",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "papaparse": "5.5.3",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.3.16",
    "@types/pdfkit": "0.17.2",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.16.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
